{% extends "ci-infrastructure/cmake-build.sh.j2" %}
{% block preflight %}
{{ super() }}
for tool in bison flex; do
  if command -v "$tool" >/dev/null 2>&1; then
    "$tool" --version | head -1
  else
    echo "$tool: NOT on PATH -- ENABLE_ECKIT_SQL/CMD will fail configure below"
  fi
done
{% endblock %}
